{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cultural Features Schema",
  "description": "Schema for narrative-focused cultural species abilities",
  "type": "object",
  "properties": {
    "cultural_features": {
      "type": "array",
      "description": "Cultural features available to this species",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the cultural feature"
          },
          "type": {
            "type": "string",
            "enum": ["narrative", "social", "cultural", "ceremonial", "traditional"],
            "description": "Type of cultural feature"
          },
          "description": {
            "type": "string",
            "description": "Narrative description of the cultural feature"
          },
          "activation": {
            "type": "string",
            "description": "When this feature can be activated"
          },
          "effect": {
            "type": "object",
            "description": "Mechanical effect of the cultural feature",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["advantage", "proficiency", "information_access", "social_bonus", "narrative_hook", "cultural_connection"],
                "description": "Type of effect provided"
              },
              "value": {
                "type": ["string", "number"],
                "description": "Value of the effect"
              },
              "conditions": {
                "type": "array",
                "description": "Conditions when this effect applies",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": { "type": "string" },
                    "op": { "type": "string" },
                    "value": { "type": ["string", "number", "array"] }
                  }
                }
              }
            },
            "required": ["type", "value"]
          },
          "narrative_enhancement": {
            "type": "string",
            "description": "How this feature enhances storytelling"
          },
          "faction_connection": {
            "type": "string",
            "description": "Connection to specific factions or groups"
          },
          "optional": {
            "type": "boolean",
            "default": true,
            "description": "Whether this feature is optional"
          },
          "prerequisites": {
            "type": "array",
            "description": "Prerequisites for accessing this feature",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["name", "type", "description", "activation", "effect", "narrative_enhancement"]
      }
    },
    "cultural_connections": {
      "type": "object",
      "description": "Cultural connections and relationships",
      "properties": {
        "primary_culture": {
          "type": "string",
          "description": "Primary cultural affiliation"
        },
        "cultural_networks": {
          "type": "array",
          "description": "Cultural networks this species has access to",
          "items": {
            "type": "string"
          }
        },
        "traditional_practices": {
          "type": "array",
          "description": "Traditional practices and ceremonies",
          "items": {
            "type": "string"
          }
        },
        "cultural_knowledge": {
          "type": "array",
          "description": "Areas of cultural knowledge and expertise",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "balance_guidelines": {
      "type": "object",
      "description": "Balance guidelines for cultural features",
      "properties": {
        "narrative_focus": {
          "type": "boolean",
          "default": true,
          "description": "Features should be primarily narrative, not mechanical"
        },
        "max_features_per_character": {
          "type": "number",
          "default": 3,
          "description": "Maximum cultural features per character"
        },
        "optional_by_default": {
          "type": "boolean",
          "default": true,
          "description": "Whether features are optional by default"
        },
        "enhance_storytelling": {
          "type": "boolean",
          "default": true,
          "description": "Features should enhance storytelling, not provide combat advantages"
        }
      }
    }
  },
  "required": ["cultural_features", "cultural_connections", "balance_guidelines"]
}
