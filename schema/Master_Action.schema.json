{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Master Action",
  "description": "The unified schema for ALL actions in the game - combat, skill, utility, and more. This is the single blueprint for every action in the SW5e x FFG system.",
  "type": "object",
  "properties": {
    "$comment": "SECTION 1: METADATA & IDENTIFICATION",
    "id": {
      "type": "string",
      "description": "Unique, machine-readable ID, e.g., 'action_attack', 'action_hack_terminal', or 'action_dodge'."
    },
    "name": {
      "type": "string",
      "description": "The display name of the action."
    },
    "action_category": {
      "enum": ["attack", "maneuver", "defensive", "utility", "environmental", "force", "tech", "social", "exploration", "downtime"],
      "description": "The category of action for organization and filtering."
    },
    "difficulty": {
      "enum": ["basic", "intermediate", "advanced", "expert"],
      "description": "The difficulty level of performing this action."
    },

    "$comment": "SECTION 2: NARRATIVE BLOCK (for the LLM-GM)",
    "narrative": {
      "type": "string",
      "description": "Rich narrative description of what the action represents and how it feels to perform. Used by LLM-GM for storytelling."
    },
    "flavor_text": {
      "type": "string",
      "description": "Iconic quote or description that captures the essence of this action, often from Star Wars lore."
    },

    "$comment": "SECTION 3: DETAILED INFORMATION",
    "description": {
      "type": "string",
      "description": "Detailed mechanical description of what the action does and its rules."
    },
    "type": {
      "enum": ["attack", "maneuver", "reaction", "bonus_action", "free_action", "downtime", "social"],
      "description": "The type of action this represents."
    },
    "cost": {
      "type": "array",
      "description": "The types of action resources this can be spent on.",
      "items": {
        "enum": ["action", "bonus_action", "reaction", "free_action", "movement", "downtime", "social"]
      }
    },

    "$comment": "SECTION 4: PREREQUISITES & REQUIREMENTS",
    "prerequisites": {
      "type": "array",
      "description": "Requirements that must be met to use this action.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["weapon_equipped", "class_feature", "power_known", "status_active", "position", "resource_available", "movement_available", "cover_available", "environmental_condition", "skill_proficiency", "tool_proficiency", "equipment_available"]
          },
          "value": {
            "type": "string",
            "description": "The specific requirement value."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the requirement."
          }
        }
      }
    },

    "$comment": "SECTION 5: TARGETING & RANGE",
    "target": {
      "type": "object",
      "description": "Defines the targeting parameters for this action.",
      "properties": {
        "type": {
          "enum": ["self", "creature", "object", "point", "area", "cone", "line", "none"]
        },
        "range": {
          "type": "integer",
          "description": "Range in feet."
        },
        "area": {
          "type": "object",
          "description": "For area effects, defines the shape and size.",
          "properties": {
            "shape": {
              "enum": ["sphere", "cube", "cone", "line", "cylinder"]
            },
            "size": {
              "type": "integer",
              "description": "Size in feet."
            }
          }
        }
      }
    },

    "$comment": "SECTION 6: ATTACK MECHANICS (for combat actions)",
    "attack": {
      "type": "object",
      "description": "Attack parameters if this is an attack action.",
      "properties": {
        "attack_type": {
          "enum": ["melee_weapon", "ranged_weapon", "unarmed", "force_power", "tech_power"]
        },
        "attack_modifier": {
          "type": "string",
          "description": "The ability modifier used for the attack roll."
        },
        "damage": {
          "type": "object",
          "properties": {
            "dice": {
              "type": "string",
              "description": "Damage dice, e.g., '1d6' or '2d8'."
            },
            "type": {
              "enum": ["slashing", "piercing", "bludgeoning", "energy", "ion", "force", "tech"]
            },
            "bonus": {
              "type": "string",
              "description": "Additional damage bonus, e.g., 'Strength modifier'."
            }
          }
        },
        "critical_range": {
          "type": "array",
          "description": "Numbers that trigger critical hits.",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },

    "$comment": "SECTION 7: SKILL CHECK MECHANICS (for skill-based actions)",
    "skill_check": {
      "type": "object",
      "description": "Skill check parameters if this action is resolved with a skill check.",
      "properties": {
        "skill": {
          "type": "string",
          "description": "The skill used for this action (e.g., 'Technology', 'Persuasion', 'Stealth')."
        },
        "dc_type": {
          "enum": ["fixed", "opposed", "variable", "contested"],
          "description": "How the DC is determined."
        },
        "dc_value": {
          "type": "integer",
          "description": "Fixed DC value (if dc_type is 'fixed')."
        },
        "opposed_by": {
          "type": "string",
          "description": "What opposes this check (if dc_type is 'opposed')."
        },
        "variable_source": {
          "type": "string",
          "description": "Source of variable DC (if dc_type is 'variable')."
        },
        "advantage_conditions": {
          "type": "array",
          "description": "Conditions that grant advantage on this skill check.",
          "items": { "type": "string" }
        },
        "disadvantage_conditions": {
          "type": "array",
          "description": "Conditions that impose disadvantage on this skill check.",
          "items": { "type": "string" }
        }
      }
    },

    "$comment": "SECTION 8: MECHANICAL EFFECTS",
    "effects": {
      "type": "array",
      "description": "The mechanical results of taking this action, using our master effects schema.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "make_attack",
              "apply_status",
              "modify_stat",
              "grant_advantage",
              "impose_disadvantage",
              "heal_hp",
              "restore_strain",
              "reduce_damage",
              "reflect_attack",
              "teleport",
              "stabilize_creature",
              "enhance_object",
              "counter_attack",
              "emergency_override",
              "create_cover",
              "destroy_cover",
              "modify_terrain",
              "apply_environmental_effect",
              "gain_information",
              "create_opportunity",
              "establish_connection",
              "resolve_conflict"
            ]
          },
          "value": {
            "type": "string",
            "description": "The specific effect value or identifier."
          },
          "target_scopes": {
            "type": "array",
            "description": "Who or what this effect applies to.",
            "items": {
              "enum": ["self", "ally", "enemy", "all_allies", "all_enemies", "all_creatures", "object", "area", "terrain", "environment", "npc", "location"]
            }
          },
          "conditions": {
            "type": "array",
            "description": "Conditions that must be met for this effect to apply.",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "The condition key to check."
                },
                "op": {
                  "enum": ["equals", "greater_than", "less_than", "not_equals", "contains", "starts_with"]
                },
                "value": {
                  "description": "The value to compare against."
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about this effect."
          }
        }
      }
    },

    "$comment": "SECTION 9: NARRATIVE CURRENCY",
    "narrative_currency": {
      "type": "object",
      "description": "How this action generates and spends narrative currency (Advantage/Threat).",
      "properties": {
        "advantage_generation": {
          "type": "array",
          "description": "Conditions that generate Advantage when using this action.",
          "items": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "string",
                "description": "What triggers Advantage generation."
              },
              "amount": {
                "type": "integer",
                "description": "Amount of Advantage generated."
              }
            }
          }
        },
        "threat_generation": {
          "type": "array",
          "description": "Conditions that generate Threat when using this action.",
          "items": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "string",
                "description": "What triggers Threat generation."
              },
              "amount": {
                "type": "integer",
                "description": "Amount of Threat generated."
              }
            }
          }
        },
        "advantage_spends": {
          "type": "array",
          "description": "Valid Advantage spends for this action.",
          "items": { "type": "string" }
        },
        "threat_spends": {
          "type": "array",
          "description": "Valid Threat spends for this action.",
          "items": { "type": "string" }
        }
      }
    },

    "$comment": "SECTION 10: SYNERGIES & INTEGRATION",
    "class_synergies": {
      "type": "array",
      "description": "Classes that have special interactions with this action.",
      "items": {
        "type": "object",
        "properties": {
          "class_id": { "type": "string" },
          "narrative": { "type": "string" },
          "mechanical_benefit": { "type": "string" }
        },
        "required": ["class_id", "narrative"]
      }
    },
    "species_synergies": {
      "type": "array",
      "description": "Species that have special interactions with this action.",
      "items": {
        "type": "object",
        "properties": {
          "species_id": { "type": "string" },
          "narrative": { "type": "string" },
          "mechanical_benefit": { "type": "string" }
        },
        "required": ["species_id", "narrative"]
      }
    },
    "faction_synergies": {
      "type": "array",
      "description": "Factions that have special interactions with this action.",
      "items": {
        "type": "object",
        "properties": {
          "faction_id": { "type": "string" },
          "narrative": { "type": "string" },
          "mechanical_benefit": { "type": "string" }
        },
        "required": ["faction_id", "narrative"]
      }
    },

    "$comment": "SECTION 11: LLM-GM INTEGRATION",
    "llm_guidance": {
      "type": "object",
      "description": "Additional guidance for LLM-GM integration.",
      "properties": {
        "iconic_usage": {
          "type": "string",
          "description": "Example of how this action is typically used in Star Wars lore."
        },
        "tactical_notes": {
          "type": "string",
          "description": "Tactical advice for when and how this action is most effective."
        },
        "narrative_hooks": {
          "type": "array",
          "description": "Story hooks and narrative elements related to this action.",
          "items": { "type": "string" }
        },
        "roleplay_guidance": {
          "type": "string",
          "description": "Guidance for roleplaying characters performing this action."
        }
      }
    },

    "$comment": "SECTION 12: IMAGE GENERATION",
    "image_generation": {
      "type": "object",
      "description": "Data source for modular AI art generation engine.",
      "properties": {
        "base_prompt": {
          "type": "string",
          "description": "Detailed foundational prompt for generating a 'stock image' of this action, with bracketed placeholders for customizable parts."
        },
        "contextual_modifiers": {
          "type": "array",
          "description": "Modifiers defining how this action adds flavor and context to other image prompts.",
          "items": {
            "type": "object",
            "properties": {
              "target_type": {
                "type": "string",
                "description": "The type of image this modifier applies to (e.g., 'Character_Portrait', 'Combat_Scene', 'Location')."
              },
              "modifier_text": {
                "type": "string",
                "description": "Text to append to the base prompt when this action is part of the context."
              }
            },
            "required": ["target_type", "modifier_text"]
          }
        }
      },
      "required": ["base_prompt", "contextual_modifiers"]
    },

    "$comment": "SECTION 13: UI INTEGRATION",
    "ui": {
      "type": "object",
      "description": "User interface assets and display information.",
      "properties": {
        "image": {
          "type": "string",
          "description": "Path to the action's representative image."
        },
        "icon": {
          "type": "string",
          "description": "Path to the action's icon for UI display."
        },
        "color": {
          "type": "string",
          "description": "Primary color for UI elements (hex code or color name)."
        }
      },
      "required": ["image", "icon", "color"]
    },

    "$comment": "SECTION 14: BALANCE & TESTING",
    "balance_considerations": {
      "type": "object",
      "description": "Balance considerations for this action.",
      "properties": {
        "power_level": {
          "enum": ["low", "medium", "high", "very_high"],
          "description": "Relative power level of this action."
        },
        "action_economy_impact": {
          "type": "string",
          "description": "How this action affects action economy."
        },
        "resource_cost": {
          "type": "string",
          "description": "Resource cost considerations."
        },
        "counterplay_options": {
          "type": "array",
          "description": "Available counterplay options against this action."
        },
        "testing_notes": {
          "type": "string",
          "description": "Notes for testing this action's balance."
        }
      }
    },

    "$comment": "SECTION 15: TAGS & CATEGORIZATION",
    "tags": {
      "type": "array",
      "description": "Keywords for categorization and filtering.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["id", "name", "action_category", "difficulty", "narrative", "description", "type", "cost", "image_generation", "ui"]
}
