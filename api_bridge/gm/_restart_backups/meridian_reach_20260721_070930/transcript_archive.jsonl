{"entry_id": "te_3_b0", "type": "narrator", "speaker_id": "narrator", "text": "", "narration": "You lunge forward with a burst of the Force, but Besk's years of experience and protective instincts save him. He instinctively braces himself against your attack, his eyes wide with shock and disbelief.", "behavior": "Besk Ollor shifts his weight to brace himself as you attempt to force choke him, remaining upright despite the strain on his neck.", "mood": "tense", "source_command_id": "cmd_1784618344_3", "created_at": "2026-07-21T03:19:04", "campaign_id": "meridian_reach", "session_id": "session_1", "scene_id": "scene_shuttle_briefing", "interaction_id": "int_scene_shuttle_briefing"}
{"entry_id": "te_3_b1", "type": "npc", "speaker_id": "operative_senn", "text": "What in the Force are you doing?!", "narration": "", "behavior": "Senn Varga stands up quickly, his face a mixture of fear and anger.", "mood": "tense", "source_command_id": "cmd_1784618344_3", "created_at": "2026-07-21T03:19:04", "campaign_id": "meridian_reach", "session_id": "session_1", "scene_id": "scene_shuttle_briefing", "interaction_id": "int_scene_shuttle_briefing"}
