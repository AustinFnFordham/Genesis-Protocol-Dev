{"entry_id": "te_4_p", "type": "player", "speaker_id": "aero", "text": "The Council sent you all to die.", "source_command_id": "cmd_1784618417_4", "created_at": "2026-07-21T03:20:17", "campaign_id": "meridian_reach", "session_id": "session_1", "scene_id": "scene_shuttle_briefing", "interaction_id": "int_scene_shuttle_briefing"}
{"entry_id": "te_4_b0", "type": "npc", "speaker_id": "operative_senn", "text": "Aero, you've got to explain this. We're all here to work together and reactivate that sensor array.", "narration": "", "behavior": "Senn leans forward on the schematics table, looking earnestly at Aero.", "mood": "tense", "source_command_id": "cmd_1784618417_4", "created_at": "2026-07-21T03:20:17", "campaign_id": "meridian_reach", "session_id": "session_1", "scene_id": "scene_shuttle_briefing", "interaction_id": "int_scene_shuttle_briefing"}
