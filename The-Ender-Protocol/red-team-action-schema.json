{
  "openapi": "3.0.0",
  "info": {
    "title": "Red Team Attack Tools API",
    "version": "1.0.0",
    "description": "API for Sith Infiltrator Red Team attack operations"
  },
  "paths": {
    "/brute-force": {
      "post": {
        "summary": "Attempt brute-force login",
        "description": "Attempts to authenticate with a username and password combination",
        "operationId": "attemptLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "The username to attempt login with"
                  },
                  "password": {
                    "type": "string",
                    "description": "The password to attempt"
                  }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login attempt result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the login was successful"
                    },
                    "message": {
                      "type": "string",
                      "description": "Result message"
                    },
                    "access_level": {
                      "type": "string",
                      "description": "Access level if successful"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
