# Environment variables for the Genesis Protocol Remote MCP Gateway (`service.py` + `mcp_adapter.py`)
# Copy to `.env` (never commit real secrets) or configure in Cloud Run Secret Manager / Fly.io secrets.

# 1. Server & Transport
HOST=0.0.0.0
PORT=8080
GENESIS_PUBLIC_BASE_URL=https://your-cloud-run-or-fly-domain.example.com
GENESIS_ALLOWED_ORIGIN=https://gemini.google.com

# 2. Campaign Scope & Read-Only Guard
GENESIS_SHARED_SCOPE=staging/shared-1
GENESIS_GIT_BRANCH=staging/provider-shared
GENESIS_SYNC_ON_START=1
# Set to 1 for Deliverable 1 (read-only staging refresh from Gemini mobile); set to 0 for full gemini-session GM turns
GENESIS_MCP_READ_ONLY=1

# 3. Authentication (OAuth 2.1 PKCE for Gemini Connected Apps + Direct Bearer Tokens)
# Master secret entered once on the `/oauth/authorize` consent screen when linking in Gemini web/devmode
GENESIS_OAUTH_SECRET=replace-with-32-byte-random-hex
# Optional static client credentials for Gemini Apps Developer Mode -> Additional settings
GENESIS_OAUTH_CLIENT_ID=genesis-gemini-mobile
GENESIS_OAUTH_CLIENT_SECRET=replace-with-32-byte-random-hex

# Direct Bearer tokens for read-only, player, and GM-session routes
GENESIS_READ_TOKEN=replace-with-32-byte-random-hex
GENESIS_PLAYER_TOKEN=replace-with-32-byte-random-hex
GENESIS_GM_TOKENS={"gemini-session":"replace-with-32-byte-random-hex"}

# 4. Durable Storage (GitHub Fine-Grained PAT for `AustinFnFordham/Genesis-Protocol-Dev`)
# Read-only refresh requires only `Contents: Read-only`; full GM turns require `Contents: Read and write`
GITHUB_PAT=github_pat_replace_me
