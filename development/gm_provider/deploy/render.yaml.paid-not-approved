services:
  - type: web
    name: genesis-shared-mobile-gateway
    runtime: docker
    repo: https://github.com/AustinFnFordham/Genesis-Protocol-Dev
    branch: dev/shared-mobile-gateway-reconciled
    region: ohio
    plan: starter
    numInstances: 1
    autoDeployTrigger: "off"
    dockerfilePath: ./development/gm_provider/deploy/Dockerfile
    dockerContext: .
    healthCheckPath: /.well-known/oauth-protected-resource/mcp
    disk:
      name: genesis-authority
      mountPath: /var/data
      sizeGB: 1
    envVars:
      - key: GENESIS_MCP_ENABLE_WRITES
        value: "0"
      - key: GENESIS_DATA_ROOT
        value: /var/data
      - key: GENESIS_MCP_ISSUER
        sync: false
      - key: GENESIS_MCP_CLIENT_PROVIDERS
        sync: false
      - key: GENESIS_MCP_SUBJECT
        sync: false
      - key: GENESIS_GITHUB_TOKEN
        sync: false
