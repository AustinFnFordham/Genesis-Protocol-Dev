# Server secret-manager inputs. Do not commit real values or paste them in chat.
GENESIS_MCP_RESOURCE=https://genesis.example.invalid/mcp
GENESIS_MCP_ISSUER=https://YOUR_AUTH0_TENANT.us.auth0.com/
# Copy the two Application Client IDs from Auth0 Dashboard. Not tool arguments.
GENESIS_MCP_CLIENT_PROVIDERS={"AUTH0_CHATGPT_CLIENT_ID":"gpt-session","AUTH0_GEMINI_CLIENT_ID":"gemini-session"}
GENESIS_MCP_SUBJECT=owner-stable-oauth-subject
GENESIS_GM_TOKENS={"gpt-session":"REPLACE_IN_HOST_SECRET_MANAGER"}
GENESIS_MCP_HOST=127.0.0.1
GENESIS_MCP_PORT=8789
# Keep disabled through the first authenticated refresh. This task authorizes no gameplay.
GENESIS_MCP_ENABLE_WRITES=0
# Later only: copy the generation from authenticated refresh after recovery review.
# GENESIS_STORAGE_GENERATION=VALUE_FROM_GENESIS_REFRESH
